# Brevo (https://app.brevo.com) transactional email API key
BRAVO_API_KEY=

# Where contact form submissions get delivered
CONTACT_TO_EMAIL=reuvinhernandez22@gmail.com

# Must be a sender identity verified in your Brevo account.
